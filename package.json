{
  "name": "signal-atlas",
  "version": "0.3.1",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "typescript": "~5.9.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @signal-atlas/web",
    "dev:api": "go -C api run ./cmd/server",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "format": "prettier --write \"web/src/**/*.{vue,ts,css}\" \"scripts/*.mjs\" \"docs/*.md\" README.md \"*.json\" \".vscode/*.json\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  }
}
