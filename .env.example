# Minimal quick start: a login for the web console (password 16–72 bytes).
SIGNAL_ATLAS_WEB_USER=admin
SIGNAL_ATLAS_WEB_PASSWORD=

# Optional: keep history in PostgreSQL. Leave empty to use SQLite
# (data/history.db) and skip running a database server entirely.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/signal_atlas?sslmode=disable

# Optional: encrypt stored device passwords at rest (64 hex characters).
# Without it, device passwords live in process memory only.
SIGNAL_ATLAS_SECRET_KEY=

# Optional: high-resolution WAN peak sampling through the router's SNMP agent.
SIGNAL_ATLAS_SNMP_HOST=
SIGNAL_ATLAS_SNMP_COMMUNITY=

# Optional: port and access control.
SIGNAL_ATLAS_PORT=8768
# Accept any private LAN address on this port (the default in compose.yaml).
# SIGNAL_ATLAS_ALLOWED_HOSTS=*:8768
# SIGNAL_ATLAS_ALLOWED_ORIGINS=
# SIGNAL_ATLAS_CONFIG=
